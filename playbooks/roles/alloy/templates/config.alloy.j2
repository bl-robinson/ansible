// Managed by ansible (roles/alloy). Node + ZFS metrics pushed to the k8s Prometheus.

prometheus.exporter.unix "node" {
  // zfs collector is on by default; textfile picks up zfs-backup-metrics output.
  textfile {
    directory = "{{ alloy_textfile_dir }}"
  }
}

discovery.relabel "node" {
  targets = prometheus.exporter.unix.node.targets

  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }

  rule {
    target_label = "job"
    replacement  = "{{ alloy_job }}"
  }
}

prometheus.scrape "node" {
  targets         = discovery.relabel.node.output
  scrape_interval = "{{ alloy_scrape_interval }}"
  forward_to      = [prometheus.remote_write.home.receiver]
}

prometheus.remote_write "home" {
  endpoint {
    url = "{{ alloy_remote_write_url }}"
  }
}
