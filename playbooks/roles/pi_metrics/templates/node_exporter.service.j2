# Managed by ansible (roles/pi_metrics)
[Unit]
Description=Prometheus node_exporter (scraped by the k8s Prometheus)
Wants=network-online.target
After=network-online.target

[Service]
User=node_exporter
Group=node_exporter
# systemd + processes collectors are used by the Node Exporter Full dashboard.
ExecStart=/usr/local/bin/node_exporter \
  --web.listen-address={{ metrics_listen_address }}:{{ node_exporter_port }} \
  --collector.textfile.directory={{ node_exporter_textfile_dir }} \
  --collector.systemd \
  --collector.processes
# The listen address may be a VPN address that comes up after boot; keep retrying.
Restart=always
RestartSec=10
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
