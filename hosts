all:
  hosts:
    hv1:
      main_interface: enp2s0
      ip_addr: 10.0.0.5
      override_dns: 8.8.8.8
      ip6_addr: 2a06:61c2:27ae::1:0003
    hv2:
      main_interface: enp0s25
      ip_addr: 10.0.0.19
      override_dns: 8.8.8.8
      ip6_addr: 2a06:61c2:27ae::1:0004
    data:
      main_interface: eth0
      ip_addr: 10.0.0.3
      sanoid_datasets:
        - name: data/data
          template: source
      ip6_addr: 2a06:61c2:27ae::1:0002
    backup:
      main_interface: eth0
      # At a remote house (192.168.0.200); reachable from home/k8s only via
      # WireGuard (wg0, 10.0.2.4 - not managed here). Public DNS so it can still
      # resolve if the tunnel is down.
      metrics_listen_address: 10.0.2.4
      override_dns: 8.8.8.8
      custom_network_config: |
        allow-hotplug eth0
        iface eth0 inet static
            address 192.168.0.200/24
            gateway 192.168.0.1
            dns-nameservers 8.8.8.8
      sanoid_datasets:
        - name: data/data
          template: replica   # zrep target: prune only, never snapshot
    shed-cam:
      main_interface: eth0
      ip_addr: 10.0.0.2
      custom_network_config: |
        auto wlan0
        iface wlan0 inet static
            address 10.0.0.2/23
            netmask 255.255.254.0
            gateway 10.0.0.1
            network 10.0.0.0
            broadcast 10.0.1.255
            dns-nameservers 10.0.0.102
            dns-search home.blrobinson.uk
            dns-domain home.blrobinson.uk
            wpa-conf /etc/wpa_supplicant/wpa_supplicant.conf

        iface wlan0 inet6 static
            address 2a06:61c2:27ae::1:0005
            netmask 64
            gateway 2a06:61c2:27ae::
            autoconf 0
            dns-nameservers 2620:fe::fe 2606:4700:4700::64
